DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEBHOOK_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# 32 random bytes, hex encoded; server-side AES-256-GCM document encryption.
DOCUMENT_KEY=replace-with-64-random-hex-characters
NODE_ENV=development
PORT=3000
# Explicitly opt in to seeded login cards, demo offset, bot and reset controls.
DEMO_ENABLED=true
# Local/test PostgreSQL only. Never set this for Neon.
DATABASE_SSL=false
# Optional isolated PostgreSQL URL for tests (otherwise a disposable local cluster).
# TEST_DATABASE_URL=
