DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEBHOOK_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# 32 random bytes, hex encoded; server-side AES-256-GCM document encryption.
DOCUMENT_KEY=replace-with-64-random-hex-characters
NODE_ENV=development
PORT=3000
# Explicitly opt in to seeded login cards, demo offset, bot and reset controls.
DEMO_ENABLED=true
# Local/test PostgreSQL only. Never set this for Neon.
# DATABASE_SSL=false
# Optional isolated PostgreSQL URL for tests (otherwise a disposable local cluster).
# TEST_DATABASE_URL=

# Emergency alerts: in-app is always enabled. External channels are opt-in.
SOS_STUDENT_VISIBLE_TO_ADMIN=true
SOS_STUDENT_VISIBLE_TO_DRIVER=false
SMS_ENABLED=false
# APP_URL=https://your-authenticated-app.example
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_SMS_FROM=+12025550100
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
